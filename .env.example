# ═══════════════════════════════════════════════════════════════
#  Copy this file to .env and fill it in. Never commit .env.
# ═══════════════════════════════════════════════════════════════

# ── Database (required) ────────────────────────────────────────
# PostgreSQL. Local dev (Docker):
DATABASE_URL="postgresql://postgres:password@localhost:5432/store"
#
# Vercel Postgres / Neon: Vercel dashboard → Storage → Create Database →
# Postgres. Copy the connection string it gives you (starts with postgres://).
# Use the pooled URL for the app; add ?sslmode=require if not already present.
#   postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/store?sslmode=require
#
# Supabase / Railway also work — any Postgres connection string.

# ── Admin login (required) ─────────────────────────────────────
ADMIN_USERNAME="admin"

# For a quick start, a plain password works:
ADMIN_PASSWORD="change-this-now"
#
# Safer: generate a hash and use that instead, leaving ADMIN_PASSWORD unset.
#   node -e "const {scryptSync,randomBytes}=require('crypto');const s=randomBytes(16).toString('hex');console.log(s+':'+scryptSync(process.argv[1],s,64).toString('hex'))" "your-password"
# ADMIN_PASSWORD_HASH="..."

# Signs the admin session cookie. MUST be long and random.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="generate-a-long-random-value-before-going-live"

# ── Public site URL (required in production) ────────────────────
# Used for SEO metadata and the Paystack payment callback.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Image storage ──────────────────────────────────────────────
# Leave everything here blank to store images on local disk (public/uploads).
# That works locally, on Hostinger and any VPS.
#
# REQUIRED ON VERCEL: Vercel's filesystem is wiped on every deploy, so
# uploaded images would disappear. Pick ONE of the two options below.
#
# Option A — Vercel Blob (simplest on Vercel, nothing external):
#   Vercel dashboard → Storage → Create → Blob → connect to the project.
#   That injects BLOB_READ_WRITE_TOKEN automatically; you don't paste it here.
#   To use Vercel Blob from local dev too, pull the token and set it:
# BLOB_READ_WRITE_TOKEN=""
#
# Option B — Cloudflare R2 or any S3 bucket (10 GB free, no egress charges):
#   Cloudflare → R2 → create bucket → enable public r2.dev URL →
#   Manage API tokens → create with "Object Read & Write".
S3_ENDPOINT=""            # https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_PUBLIC_URL=""          # https://pub-xxxx.r2.dev  or your CDN domain
S3_REGION="auto"

# ── Order emails (optional but strongly recommended) ───────────
# Customers expect a confirmation immediately, and you get an alert with the
# buyer's phone number the moment an order lands.
#
# Leave blank and the store works exactly the same, just without emails.
#
# Setup (about 5 minutes, free for 3,000 emails/month):
#   1. Sign up at resend.com
#   2. Add your domain and add the DNS records they show you
#   3. API Keys → create one
#
# EMAIL_FROM must be on a domain you verified with Resend. Gmail/Yahoo
# addresses will be rejected.
RESEND_API_KEY=""
EMAIL_FROM="Your Store <orders@yourdomain.com>"

# Where new-order alerts go. Falls back to contact.email in store.config.ts.
OWNER_EMAIL=""

# ── Payments (optional) ────────────────────────────────────────
# Without these the store still works: orders are saved as pending so you can
# arrange bank transfer or WhatsApp payment.
#
# Paystack dashboard → Settings → API Keys & Webhooks.
# Add this webhook URL there:  https://your-domain.com/api/paystack/webhook
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
